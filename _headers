# Cloudflare Pages headers. Unlike Netlify, CF applies ALL matching rules
# and joins same-name headers, so asset rules must detach (!) the inherited
# Cache-Control before setting their own.

/*
  Cache-Control: public, max-age=900, s-maxage=10800

/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000

/*.png
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000

/*.gif
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000

/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000

/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000

/*.webm
  ! Cache-Control
  Cache-Control: public, max-age=31536000, s-maxage=31536000
