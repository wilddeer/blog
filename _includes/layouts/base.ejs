<%_
    let imageUrl;
    const baseUrl = 'https://grumpy.blog';
_%>
<!doctype html>
<html lang="<%= $.lang %>">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <!-- apply the reader's saved theme choice before first paint -->
        <script>
            try {
                const theme = localStorage.getItem('theme');
                if (theme) document.documentElement.dataset.theme = theme;
            } catch (e) {}
        </script>

        <title><%= $.title %></title>
        <% if ($.description) { %>
            <meta name="description" content="<%= $.description %>">
        <% } %>

        <!-- og -->
        <meta property="og:site_name" content="Grumpy Blog">
        <meta property="og:title" content="<%= $.title %>">
        <meta property="og:url" content="<%= baseUrl %>/<%= $.permalink.replace(/^\//, '') %>">
        <meta property="og:type" content="<%= $.tags.includes('page') ? 'website' : 'article' %>">
        <meta property="og:locale" content="<%= $.lang %>">
        <% if ($.image) {
            imageUrl = baseUrl;

            if (!$.image.startsWith('/')) {
                imageUrl += `/${$.permalink.replace(/^\//, '')}`;
            }

            imageUrl += $.image;
        %>
            <meta property="og:image" content="<%= imageUrl %>">
        <% } %>
        <% if ($.description) { %>
            <meta property="og:description" content="<%= $.description %>">
        <% } %>

        <!-- twitter -->
        <meta name="twitter:card" content="<%- $.image ? 'summary_large_image' : 'summary' %>"></meta>
        <meta name="twitter:creator" content="@wildir"></meta>
        <meta name="twitter:site" content="@wildir"></meta>
        <% if ($.image) { %>
            <meta name="twitter:image" content="<%= imageUrl %>">
        <% } %>

        <!-- browser chrome color -->
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fffff9">
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1817">

        <!-- favicon -->
        <link rel="icon" type="image/svg+xml" href="/pics/happy-sun.svg">

        <!--
            fonts used at first paint, fetched in parallel with the
            render-blocking stylesheet: without preload the browser
            only discovers them after parsing the CSS, i.e. after the
            first paint whenever they aren't in cache (the dev server
            sends no cache headers at all), which flashed the fallback
            font and its layout on every local reload
        -->
        <link rel="preload" href="/fonts/nunito-v14-latin-ext_latin_cyrillic-ext_cyrillic-regular.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/nunito-v14-latin-ext_latin_cyrillic-ext_cyrillic-italic.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/nunito-v14-latin-ext_latin_cyrillic-ext_cyrillic-700.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="/fonts/fira-code-v9-latin_cyrillic-regular.woff2" as="font" type="font/woff2" crossorigin>

        <!-- styles -->
        <link rel="stylesheet" href="/css/styles.css">
    </head>

    <body>
        <%- $.content %>

        <script>
            (function () {
                const root = document.documentElement;
                const systemDark = matchMedia('(prefers-color-scheme: dark)');
                const current = () => root.dataset.theme || (systemDark.matches ? 'dark' : 'light');

                function apply(next) {
                    // picking the system theme back clears the override
                    if ((next === 'dark') === systemDark.matches) {
                        delete root.dataset.theme;
                        try { localStorage.removeItem('theme'); } catch (e) {}
                    } else {
                        root.dataset.theme = next;
                        try { localStorage.setItem('theme', next); } catch (e) {}
                    }

                    // keep the browser chrome color in sync with the override
                    document.querySelectorAll('meta[name="theme-color"]').forEach(meta => {
                        meta.content = next === 'dark' ? '#1a1817' : '#fffff9';
                    });
                }

                document.querySelectorAll('.js-theme-toggle').forEach(button => {
                    button.addEventListener('click', () => {
                        // arm the icon morph transitions (see .theme-toggle)
                        root.classList.add('theme-anim');

                        const next = current() === 'dark' ? 'light' : 'dark';

                        if (
                            !document.startViewTransition ||
                            matchMedia('(prefers-reduced-motion: reduce)').matches
                        ) {
                            apply(next);
                            return;
                        }

                        // day breaks (or night falls) in a circle from the toggle
                        const transition = document.startViewTransition(() => apply(next));

                        transition.ready.then(() => {
                            const rect = button.getBoundingClientRect();
                            const x = rect.left + rect.width / 2;
                            const y = rect.top + rect.height / 2;
                            const radius = Math.hypot(
                                Math.max(x, innerWidth - x),
                                Math.max(y, innerHeight - y)
                            );

                            document.documentElement.animate(
                                {
                                    clipPath: [
                                        `circle(0 at ${x}px ${y}px)`,
                                        `circle(${radius}px at ${x}px ${y}px)`
                                    ]
                                },
                                {
                                    duration: 500,
                                    easing: 'ease-in-out',
                                    pseudoElement: '::view-transition-new(root)'
                                }
                            );
                        });
                    });
                });
            }());
        </script>
    </body>
</html>
